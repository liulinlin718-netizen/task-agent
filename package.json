{
  "name": "task-agent",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1 --strictPort",
    "dev:electron": "concurrently --kill-others \"npm run dev\" \"node electron-wait.cjs\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "build:exe": "npm run build && electron-builder build --win",
    "build:mac": "npm run build && electron-builder build --mac",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run build",
    "setup:electron": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.taskagent.app",
    "productName": "TaskAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json",
      "electron/**/*.cjs",
      "LICENSE",
      "resources/icons/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icons/icon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TaskAgent"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Local-first task assistant with tool calling, long-term memory, and proactive desktop reminders.",
  "author": "liulinlin718-netizen",
  "license": "MIT",
  "homepage": "https://github.com/liulinlin718-netizen/task-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liulinlin718-netizen/task-agent.git"
  },
  "bugs": {
    "url": "https://github.com/liulinlin718-netizen/task-agent/issues"
  }
}
